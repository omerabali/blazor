@page "/appointments/new"
@using System.Text.Json
@inject SalonDataService Data
@inject BookingStateService Booking
@inject AppointmentStore Store
@inject AvailabilityService Availability
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Randevu al</PageTitle>

<div class="page">
@if (_loadError is not null)
{
    <p class="banner" role="alert">@_loadError</p>
    <div class="load-actions">
        <button class="btn" type="button" @onclick="LoadAsync">Tekrar dene</button>
        <a href="services">Hizmetlere dön</a>
    </div>
}
else if (!_ready)
{
    <p class="status">Salon bilgileri yükleniyor…</p>
}
else if (Chosen.Count == 0)
{
    <header class="page-head">
        <p class="eyebrow">Randevu</p>
        <h1>Önce hizmet seçin</h1>
        <p>Uygun çalışan ve saat, seçtiğiniz hizmetlere göre hesaplanır.</p>
        <a class="btn" href="services">Hizmetlere git</a>
    </header>
}
else
{
    var slots = Slots;
    var hasEligibleEmployee = AvailabilityService.Eligible(_employees, Booking.SelectedServiceIds).Any();
    <header class="page-head">
        <p class="eyebrow">Randevu</p>
        <h1>Çalışan ve saat</h1>
        <p>
            @SalonFormat.Duration(TotalMinutes) · @SalonFormat.Money(TotalPrice)
            <a href="services">Hizmetleri değiştir</a>
        </p>
        <ul class="chips">
            @foreach (var service in Chosen)
            {
                <li>@service.Name</li>
            }
        </ul>
    </header>

    <ol class="steps" aria-label="Randevu adımları">
        <li class="is-done">1. Hizmet</li>
        <li class="@(StepClass(2))" aria-current="@(Step == 2 ? "step" : null)">2. Çalışan</li>
        <li class="@(StepClass(3))" aria-current="@(Step == 3 ? "step" : null)">3. Gün ve saat</li>
        <li class="@(StepClass(4))" aria-current="@(Step == 4 ? "step" : null)">4. Bilgiler</li>
    </ol>

    <div class="book">
        <section class="panel step-staff">
            <h2>Çalışan</h2>
            <EmployeeSelector Employees="_employees"
                              RequiredServiceIds="Booking.SelectedServiceIds"
                              SelectedId="@Booking.EmployeeId"
                              Disabled="_saving"
                              OnSelected="SelectEmployee" />
            @if (!hasEligibleEmployee)
            {
                <a class="btn section-action" href="services">Hizmetleri değiştir</a>
            }
        </section>

        @if (hasEligibleEmployee)
        {
            <section class="panel step-time">
                <h2>Gün ve saat</h2>
                @if (ChosenEmployee is null)
                {
                    <p class="note">Takvimi açmak için önce bir çalışan seçin.</p>
                }
                else
                {
                    <AppointmentCalendar SelectedDate="Booking.Date"
                                         OnDateSelected="SelectDate"
                                         SelectedStart="Booking.StartTime"
                                         OnTimeSelected="SelectStart"
                                         Slots="slots"
                                         ShowSlots="ShowSlots"
                                         Disabled="_saving"
                                         SlotHint="@GetSlotHint(slots)" />
                }
            </section>
        }

        <section class="panel step-summary">
            <h2>Randevu özeti</h2>
            <AppointmentSummary Services="Chosen"
                                Employee="ChosenEmployee"
                                Date="Booking.Date"
                                Start="Booking.StartTime"
                                TotalMinutes="TotalMinutes"
                                TotalPrice="TotalPrice" />
        </section>

        @if (_formOpened)
        {
            <section class="panel step-form">
                <h2>Bilgileriniz</h2>
                <p class="note">Kayıt bu tarayıcıda kalır.</p>
                <CustomerForm Model="_customer" OnValidSubmit="ConfirmAsync" Error="@_error" Busy="_saving"
                              Confirmation="@Confirmation" />
            </section>
        }
    </div>
}
</div>

@code {
    private IReadOnlyList<SalonService> _services = [];
    private IReadOnlyList<Employee> _employees = [];
    private IReadOnlyList<BusySlot> _busy = [];
    private IReadOnlyList<Appointment> _appointments = [];
    private readonly CustomerInfo _customer = new();
    private string? _loadError;
    private string? _error;
    private bool _ready;
    private bool _saving;
    private bool _formOpened;
    private bool _disposed;

    private List<SalonService> Chosen =>
        _services.Where(service => Booking.SelectedServiceIds.Contains(service.Id)).ToList();

    private int TotalMinutes => Chosen.Sum(service => service.DurationMinutes);
    private decimal TotalPrice => Chosen.Sum(service => service.Price);

    private Employee? ChosenEmployee =>
        _employees.FirstOrDefault(employee => employee.Id == Booking.EmployeeId);

    private bool ShowSlots => Booking.EmployeeId is not null && Booking.Date is not null;

    private string? Confirmation => ShowSlots && Booking.Date is { } date && Booking.StartTime is { } start
        ? $"{SalonFormat.Date(date)}, {SalonFormat.Clock(start)}"
        : null;

    private int Step
    {
        get
        {
            if (Booking.EmployeeId is null)
                return 2;
            if (Booking.Date is null || Booking.StartTime is null)
                return 3;
            return 4;
        }
    }

    private string StepClass(int index) => index == Step ? "is-current" : index < Step ? "is-done" : "";

    private IReadOnlyList<TimeSlotOption> Slots =>
        !ShowSlots || Booking.Date is null || Booking.EmployeeId is null
            ? []
            : Availability.GetSlots(Booking.Date.Value, TotalMinutes, Booking.EmployeeId, _busy, _appointments);

    private string? GetSlotHint(IReadOnlyList<TimeSlotOption> slots)
    {
        if (Booking.EmployeeId is null)
            return "Saatleri görmek için bir çalışan seçin.";
        if (Booking.Date is null)
            return "Bir gün seçin. Geçmiş günler kapalıdır.";
        if (slots.Count == 0)
            return "Seçilen hizmetlerin toplam süresi 19:00 kapanışına sığmıyor.";

        var available = slots.Count(slot => slot.IsSelectable);
        if (available > 0)
            return $"{available} uygun başlangıç saati var.";

        return slots.All(slot => slot.State == SlotState.Past)
            ? "Bugünün başlangıç saatleri geçti."
            : "Bu günde uygun saat kalmadı. Başka bir gün seçin.";
    }

    protected override Task OnInitializedAsync()
    {
        Booking.Changed += OnChanged;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loadError = null;
        try
        {
            _services = await Data.GetServicesAsync();
            _employees = await Data.GetEmployeesAsync();
            if (Chosen.Count > 0)
            {
                _busy = await Data.GetBusySlotsAsync();
                _appointments = await Store.GetAllAsync();
                Booking.ClearEmployeeIfMissing(AvailabilityService.Eligible(_employees, Booking.SelectedServiceIds).Select(employee => employee.Id));
                DropStaleStart();
                _formOpened = Booking.StartTime is not null;
            }
            _ready = true;
        }
        catch (Exception)
        {
            _loadError = "Randevu için gerekli bilgiler yüklenemedi.";
        }
    }

    private void SelectEmployee(string id)
    {
        if (_saving)
            return;
        Booking.SetEmployee(id);
        _error = null;
    }

    private void SelectDate(DateOnly date)
    {
        if (_saving)
            return;
        Booking.SetDate(date);
        _error = null;
    }

    private void SelectStart(TimeOnly start)
    {
        if (_saving)
            return;
        Booking.SetStartTime(start);
        _formOpened = true;
        _error = null;
    }

    private void DropStaleStart()
    {
        if (Booking.StartTime is null)
            return;

        var stillOpen = Slots.Any(slot => slot.Start == Booking.StartTime && slot.IsSelectable);
        if (!stillOpen)
            Booking.SetStartTime(null);
    }

    private async Task ConfirmAsync(CustomerInfo customer)
    {
        if (_saving)
            return;

        if (Booking.EmployeeId is null || Booking.Date is null || Booking.StartTime is null)
        {
            _error = "Çalışan, gün ve uygun bir saat seçin.";
            return;
        }

        _saving = true;
        _error = null;
        var start = Booking.Date.Value.ToDateTime(Booking.StartTime.Value);
        var appointment = new Appointment
        {
            EmployeeId = Booking.EmployeeId,
            ServiceIds = Chosen.Select(service => service.Id).ToList(),
            StartAt = start,
            EndAt = start.AddMinutes(TotalMinutes),
            TotalPrice = TotalPrice,
            CustomerName = customer.FullName.Trim(),
            Email = customer.Email.Trim(),
            Phone = customer.Phone.Trim(),
            IsCancelled = false
        };

        try
        {
            var result = await Store.TryAddAsync(appointment, _busy);
            if (_disposed)
                return;

            _appointments = result.Appointments;
            if (!result.Changed)
            {
                _error = "Bu saat artık uygun değil. Başka bir saat seçin.";
                Booking.SetStartTime(null);
                return;
            }

            Booking.SetStartTime(null);
            Booking.MarkCreated(appointment.Id);
            Nav.NavigateTo("/my-appointments");
        }
        catch (Exception ex) when (ex is JSException or JsonException)
        {
            _error = "Randevu tarayıcıya kaydedilemedi. Güncel bir tarayıcıda HTTPS veya localhost üzerinden açın, depolamayı kontrol edin ve tekrar deneyin.";
        }
        finally
        {
            _saving = false;
        }
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        _disposed = true;
        Booking.Changed -= OnChanged;
    }
}
