@{
    var matches = AvailabilityService.Eligible(Employees, RequiredServiceIds).ToList();
}
@if (matches.Count == 0)
{
    <p class="empty" role="status">Seçilen hizmetlerin tümünü veren çalışan yok. Hizmet seçimini daraltın.</p>
}
else
{
    <div class="grid" role="group" aria-label="Uygun çalışanlar">
        @foreach (var employee in matches)
        {
            var id = employee.Id;
            var selected = SelectedId == id;
            <label @key="id" class="card @(selected ? "is-selected" : null)">
                <input type="radio" name="booking-employee" value="@id" checked="@selected" disabled="@Disabled"
                       @onchange="() => OnSelected.InvokeAsync(id)" />
                <span class="face"><Portrait Src="@employee.Image" Name="@employee.FullName" /></span>
                <span class="copy">
                    <span class="name">@employee.FullName</span>
                    @if (!string.IsNullOrWhiteSpace(employee.Title))
                    {
                        <span class="title">@employee.Title</span>
                    }
                </span>
                <span class="check" aria-hidden="true">@(selected ? "✓" : "")</span>
            </label>
        }
    </div>
}

@code {
    [Parameter] public IReadOnlyList<Employee> Employees { get; set; } = [];
    [Parameter] public IReadOnlyCollection<string> RequiredServiceIds { get; set; } = [];
    [Parameter] public string? SelectedId { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<string> OnSelected { get; set; }
}
