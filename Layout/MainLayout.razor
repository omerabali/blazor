@inherits LayoutComponentBase
@inject SalonContentService Content

<div class="shell">
    <header class="topbar">
        <div class="topbar-inner">
            <a class="brand" href="" aria-label="Atölye ana sayfa">
                <span class="mark" aria-hidden="true">A</span>
                <span class="brand-text">
                    <strong>Atölye</strong>
                    <small>Kuaför · Berber</small>
                </span>
            </a>
            <NavMenu />
        </div>
    </header>
    <main class="canvas">
        @Body
    </main>
    <footer class="foot">
        <div class="foot-inner">
            <div class="foot-brand">
                <p class="foot-mark">Atölye</p>
                <p>@Blurb</p>
                <a class="btn" href="services">Hizmet seç</a>
            </div>
            <div>
                <p class="foot-label">Saat</p>
                <p>@Hours</p>
            </div>
            <div>
                <p class="foot-label">Telefon</p>
                <a href="@Tel">@Phone</a>
            </div>
            <div>
                <p class="foot-label">Gez</p>
                <a href="services">Hizmetler</a>
                <a href="ekip">Ekip</a>
                <a href="salon">Salon</a>
                <a href="my-appointments">Randevularım</a>
            </div>
        </div>
        <p class="foot-copy">© @DateTime.Now.Year Atölye · Kırklareli</p>
    </footer>
</div>

@code {
    private SalonProfile _salon = new();

    private string Blurb => string.IsNullOrWhiteSpace(_salon.Tagline)
        ? "Kırklareli'nde saç, sakal ve bakım."
        : _salon.Tagline;

    private string Hours => string.IsNullOrWhiteSpace(_salon.Hours) ? "Her gün 09:00 – 19:00" : _salon.Hours;
    private string Phone => string.IsNullOrWhiteSpace(_salon.Phone) ? "0288 214 45 90" : _salon.Phone;
    private string Tel => "tel:" + new string(Phone.Where(char.IsDigit).ToArray());

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _salon = await Content.GetSalonAsync();
        }
        catch (Exception)
        {
            _salon = new SalonProfile();
        }
    }
}
